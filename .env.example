# Copy to .env. Everything is optional: the pipeline runs end-to-end from the committed
# snapshot and LLM cache with no keys at all.

# Only needed to re-pull Google Maps data live (otherwise data/raw/maps_phoenix.json is used).
APIFY_TOKEN=

# LLM backend for src/generate.py, tried in this order:
#   1. ANTHROPIC_API_KEY set  -> Anthropic API (model below)
#   2. `claude` CLI installed -> `claude -p` headless (no key needed)
#   3. neither                -> committed cache only (data/cache/llm_cache.jsonl)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
